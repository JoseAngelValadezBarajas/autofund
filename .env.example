# AutoFund configuration contract.
#
# This file documents every environment variable AutoFund reads. It contains NO real credentials:
# the values below are placeholders. Copy it to `.env` and fill in real values only if you intend
# to run against a real exchange account, which you almost certainly do not need to do in order to
# read this repository.
#
# Nothing here is required to run the demo. A fresh clone with no `.env` file at all starts in
# DEMO mode and needs none of these variables.

# ================================================================================================
# 1. MODE — which of the three operating modes to run in
# ================================================================================================
#
#   demo        (DEFAULT)  Synthetic data. No credentials, no exchange access, no order can be
#                          placed. Safe on any machine. Credentials present in the environment are
#                          removed for the duration of the run.
#   shadow                 Real public market data, read-only. No orders. No account required.
#   production             Real account, real money. Requires credentials and an explicit operator
#                          authorization for every session.
#
# Unset means `demo`. An unrecognised value is an error: AutoFund refuses to guess, because
# guessing wrong in the production direction spends money.
#
# AUTOFUND_MODE=demo

# ================================================================================================
# 2. DEMO — nothing to configure
# ================================================================================================
#
# Demo mode reads no secrets. There is no demo credential, no demo account and no demo endpoint.
# The `AUTOFUND_BITSO_*` variables below are ignored entirely in demo mode and are removed from the
# process environment before any client could read them.
#
#   autofund demo
#
# (There is nothing to set in this section. It exists so a reader looking for demo configuration
# finds an explicit statement that there is none.)

# ================================================================================================
# 3. SHADOW — read-only public market data
# ================================================================================================
#
# Shadow mode uses unauthenticated public endpoints. It needs no key and cannot place an order.

# ================================================================================================
# 4. PRODUCTION — real account, real money
# ================================================================================================
#
# Everything below is required only for production mode. Read docs/SECURITY.md and
# docs/OPERATIONS_RUNBOOK.md before enabling any of it.
#
# Use an API key issued with the minimum permissions the task needs. AutoFund never needs
# withdrawal or transfer permission, and no code path in this repository requests it.

# Bitso production ("live") credentials. These are what the trading path reads.
AUTOFUND_BITSO_LIVE_API_KEY=your-production-api-key
AUTOFUND_BITSO_LIVE_API_SECRET=your-production-api-secret

# An explicit acknowledgement that the key you supplied is a real-money production key. AutoFund
# refuses to start a production session unless this is exactly `true`. It exists so that pointing a
# live key at the application is a deliberate act rather than an accident of environment.
AUTOFUND_BITSO_LIVE_PERMISSIONS_CONFIRMED=false

# Bitso Stage credentials, used only by the F3 stage-execution certification path.
AUTOFUND_BITSO_STAGE_API_KEY=your-stage-api-key
AUTOFUND_BITSO_STAGE_API_SECRET=your-stage-api-secret

# Bitso read-only production credentials, used by the F4/F4.6 observability tools. These need no
# trading permission at all.
AUTOFUND_BITSO_PROD_API_KEY=your-read-only-api-key
AUTOFUND_BITSO_PROD_API_SECRET=your-read-only-api-secret

# ================================================================================================
# 5. OPTIONAL OVERRIDES
# ================================================================================================
#
# These change where AutoFund reads or writes. They are not needed for normal use, and setting one
# incorrectly can point a run at the wrong journal. Every one of them is stripped in demo mode.

# Where the durable execution journal lives. It is single-writer: two processes cannot share it.
# AUTOFUND_LIVE_JOURNAL=C:\AutoFund\execution.jsonl

# ================================================================================================
# 6. WHAT IS DELIBERATELY ABSENT
# ================================================================================================
#
# AutoFund has no variable that enables automated promotion of a strategy to production, no
# variable that raises the capital limits, and no variable that disables the risk or economic
# guards. Those are code-level constants reviewed with tests, not environment settings, because a
# mistyped environment variable should not be able to widen a financial safety limit.
